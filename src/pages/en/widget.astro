---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/universal-credit/" title="Universal Credit calculator 2026/27" width="100%" height="1250" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Universal Credit calculator 2026/27 on your site" description="Put the Universal Credit calculator 2026/27 on your own website for free: one iframe, no sign-up, no tracking, with the April rates and the rent cap of every area kept up to date." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the Universal Credit calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. Advice charities, food banks, housing associations and local newsrooms use it so that people can see what they might get before a first appointment.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: leave the credit link under the calculator visible, do not alter the widget, and use it as it is, with no warranty. When the rates change in April, the embedded version changes with them.</p>
    <p>Nothing your visitors type reaches us: the sums are done in their browser and the iframe sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/universal-credit/" title="Universal Credit calculator 2026/27" width="100%" height="1250" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
